<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    发布门禁用的 Checkstyle 规则集（maven-checkstyle-plugin 3.6.0，绑定 verify 阶段）。

    设计原则：
      1. 只启用「低争议、能明确判定对错」的规则，不做风格重排；
      2. 存量豁免集中写在 config/checkstyle/suppressions.xml（按文件 + 按检查项），
         新代码不允许新增违规；豁免只减不增（ratchet）；
      3. 刻意不启用 TrailingComment / WhitespaceAround / Javadoc 系列等主观规则。

    本地命令：mvn -B checkstyle:check
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="charset" value="UTF-8"/>

    <!-- 存量豁免：只针对「文件 + 检查项」，不整文件静音 -->
    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
    </module>

    <!-- 缩进制表符：统一 4 空格 -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- 行宽上限 160（非 80/100 的教条值）：当前代码里少数中文提示词/长 URL 已登记豁免 -->
    <module name="LineLength">
        <property name="max" value="160"/>
        <property name="tabWidth" value="4"/>
    </module>

    <module name="TreeWalker">
        <!-- 禁止通配符 import；存量实体/控制器已在 suppressions.xml 豁免（ratchet 逐个展开） -->
        <module name="AvoidStarImport"/>

        <!-- 未使用 / 重复的 import（processJavadoc=true：@link 里引用的 import 不算未使用） -->
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>
        <module name="RedundantImport"/>
    </module>
</module>