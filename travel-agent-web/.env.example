# 高德开放平台「Web 端(JS API)」Key（不是后端使用的「Web 服务」Key）
# 复制本文件为 .env.local 后填写；.env.local 已被 Git 忽略。
VITE_AMAP_KEY=

# 与上述 Key 配套的安全密钥（securityJsCode）
VITE_AMAP_SECURITY_CODE=

# 足迹地图底图：amap（默认，高德栅格 + MapLibre 球体）或 osm（原 OSM/OpenFreeMap）
# 高德底图使用 GCJ-02，代码会在渲染前自动转换；业务数据仍存 WGS-84。
VITE_FOOTPRINT_BASEMAP=amap
