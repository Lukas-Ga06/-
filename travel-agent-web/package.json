{
  "name": "travel-agent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:check": "npm run build && node scripts/check-bundle-budget.mjs",
    "analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "api:generate": "openapi-typescript ../docs/api/openapi.json -o src/api/generated/schema.d.ts",
    "api:check": "node scripts/check-openapi-types.mjs",
    "e2e": "playwright test",
    "test:e2e:mobile": "node e2e/run-suite.mjs mobile",
    "test:e2e:network": "node e2e/run-suite.mjs network",
    "test:e2e:multi": "node e2e/run-suite.mjs multi",
    "test:e2e:device": "node e2e/run-suite.mjs device",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "antd": "^5.21.4",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "echarts": "^6.1.0",
    "maplibre-gl": "6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "happy-dom": "^21.0.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "rollup-plugin-visualizer": "^6.0.11",
    "terser": "^5.51.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
