# =============================================================================
# travel-agent 生产环境变量模板（.env.production.example）
#
# 用法：
#   1) cp .env.production.example .env
#   2) 用 `openssl rand -base64 48` 生成 JWT_SECRET 后填入（解码后必须 >= 32 字节）
#   3) 填入你自己的 LLM / 高德 Key，其余保持占位
#   4) 启动前先渲染检查：docker compose config
#
# 纪律：
#   - 本文件只有占位符，**禁止写入任何真实密钥**；.env 本身不入库（见 .gitignore）。
#   - 只有出现在 docker-compose.yml `environment:` 里的变量才会进入容器。
#     当前 compose 已透传绝大部分变量；仍不能只靠 .env 改变的是：
#       * TELEGRAM_POLL_TIMEOUT（需 override）；
#       * MYSQL_HOST / MYSQL_PORT / MYSQL_DATABASE / MYSQL_USERNAME（compose 字面量固定）；
#       * 外部 Redis 的 host/port/密码/TLS 与 S3 的重试/超时等细项（需 override 或 SPRING_APPLICATION_JSON）。
#     完整核对见 docs/operations/production-config.md §5。
#   - 默认值以 travel-agent-server/src/main/resources/application.yml 为准；
#     本文给的是「生产建议值」，不等于代码默认值。
#   - 最后核对：2026-11-22（Asia/Shanghai）。改代码默认值后必须同步本文件与配置清单。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 必填：JWT 签名密钥
# -----------------------------------------------------------------------------
# Base64 字符串，解码后 >= 32 字节（JwtService.MIN_KEY_BYTES）。
# 非法 Base64 或长度不足 → **启动失败**；完全不配置 → 启动生成一次性随机密钥并 WARN，
# 重启后所有已签发 token 失效（compose 用 ${JWT_SECRET:?...} 强制要求，缺失直接拒绝启动）。
# 生成：openssl rand -base64 48
JWT_SECRET=<openssl rand -base64 48 生成后粘贴，解码后 48 字节>

# token 有效期（小时）。默认 72；compose 已透传。
JWT_EXPIRE_HOURS=72
# 短期只读票据（照片原图 / SSE）有效期（秒）。默认 300；compose 已透传。
TICKET_TTL_SECONDS=300


# -----------------------------------------------------------------------------
# 2. 安全开关（生产值已给出；不要改回开发默认）
# -----------------------------------------------------------------------------
# HTTPS 部署必须 true；纯 HTTP 部署设 true 会表现为「登录成功但立刻 401」（Cookie 不回传）。
COOKIE_SECURE=true
# 生产必须 false：true 会在启动时创建 demo/demo123 弱密码账号。
# 注意：改成 false 不会删除已创建的 demo 账号，需手工清理（见 docs/guide/deployment.md §3.3）。
DEMO_ACCOUNT=false
# 必须 false：true 会把 /h2-console/** 加进免认证白名单（SecurityConfig），生产等于匿名入口。
# compose 已透传；保持 false。
H2_CONSOLE_ENABLED=false
# 限流总开关。默认 true；compose 已透传。
RATE_LIMIT_ENABLED=true
# 限流计数存储：compose 默认 redis（内置 redis 服务，多实例共享配额）。
# 单实例也可设 memory；Redis 运行期故障时代码 fail-open 放行并告警。
RATE_LIMIT_STORE=redis
# 账号级数据导出（GET /api/auth/me/export）专用配额：窗口内同一用户最多几次。
# 一次导出读完该用户全部归属数据，正常用户不会连续导出；compose 已透传。
RATE_LIMIT_EXPORT=3
# 前端来源白名单（逗号分隔，不能是 *）。同源 nginx 反代部署时填网站自己的源。
CORS_ALLOWED_ORIGINS=https://your-domain.example.com
# 仅当后端只经 nginx 反代可达时配置；必须覆盖反代来源网段，否则所有请求按代理 IP 共用一个桶。
RATE_LIMIT_TRUSTED_PROXIES=172.16.0.0/12


# -----------------------------------------------------------------------------
# 3. LLM（OpenAI-compatible）
# -----------------------------------------------------------------------------
LLM_ENABLED=true
LLM_BASE_URL=https://api.deepseek.com/v1
# 只放环境变量，绝不写进仓库。未配置时全链路降级规则引擎（llm.calls{result=skipped}）。
LLM_API_KEY=<LLM_API_KEY 占位：从供应商控制台复制>

# 模型名必须与当前 Key 的 /models 清单一致。
# 2026-11-22 用当前 Key 核对：可用 deepseek-flash、deepseek-v4-pro；application.yml 与 docker-compose.yml 默认均已对齐。
# 换 provider / 换 Key 后必须重新核对；模型不可用时启动会 WARN，并在 /api/system/status 显示
# llmModelAvailable=false + llmModelError（探测进行中为 llmModelCheckPending=true）。
LLM_MODEL=deepseek-flash
# 启动后异步探测 GET {LLM_BASE_URL}/models（超时 ≤3s）。默认 true；排障/无外网可设 false，
# 此时 llmModelAvailable=null（未校验），不能当成可用。compose 已透传。
LLM_MODEL_PROBE_ENABLED=true
LLM_TEMPERATURE=0.4
LLM_CONNECT_TIMEOUT_MS=5000
LLM_READ_TIMEOUT_MS=30000
# 每用户每日 LLM 调用上限；0=不限。生产必须设正值防止单账号刷爆账单。
# 计数落库 llm_quota_usage（多实例共享），超限降级规则引擎并记 llm.calls{result=quota}。
# compose 已透传。
LLM_DAILY_QUOTA=200


# -----------------------------------------------------------------------------
# 4. Embedding（显式降级）
# -----------------------------------------------------------------------------
# 默认 false：RAG 走本地字符 bigram 哈希向量，离线可用、无语义精度。
# 开启前必须确认 Key、端点与模型；开启后一旦失败会**进程内锁定降级**，恢复需重启。
# 切换模型必须清空 rag_document / rag_chunk / rag_document_version 重建知识库。
EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=<EMBEDDING_API_KEY 占位；EMBEDDING_ENABLED=false 时不需要>
EMBEDDING_MODEL=BAAI/bge-m3
RAG_MIN_SCORE=0.05


# -----------------------------------------------------------------------------
# 5. 高德地图与 MCP
# -----------------------------------------------------------------------------
# 后端高德「Web 服务」Key（地理编码 / POI / 路线）。类型必须选「Web 服务」，
# 不能复用前端 JS API Key。compose 已透传。
AMAP_KEY=<AMAP_KEY 占位：高德控制台「Web服务」类型 Key>

# 高德 MCP server 的 Key（变量名是 AMAP_MAPS_API_KEY，单数 KEY），与 AMAP_KEY 不是同一个值。
# 只有 MCP_ENABLED=true 且该 Key 有效时才会拉起 npx 子进程并注册 mcp_amap_* 工具；
# 缺 Key / 子进程失败只 WARN 跳过，不影响启动。
AMAP_MAPS_API_KEY=<AMAP_MAPS_API_KEY 占位：高德「Web服务」类型 Key>
MCP_ENABLED=true

# 前端高德「Web 端(JS API)」Key 与安全密钥：构建期注入（docker compose build args），
# 会出现在前端产物里，属公开标识，不是后端密钥；仍建议按域名做白名单。
VITE_AMAP_KEY=<VITE_AMAP_KEY 占位：高德控制台「Web端(JS API)」Key>
VITE_AMAP_SECURITY_CODE=<VITE_AMAP_SECURITY_CODE 占位>
VITE_FOOTPRINT_BASEMAP=amap

# 真实天气（Open-Meteo，免费无 Key）：默认开启，不需要额外配置。
# 拿不到真实天气即「不可用」，依赖天气的行程修改会被明确拒绝（不会用模拟数据改行程）。
# 生产环境不要打开模拟开关（仅测试/离线演示用；状态接口会自报 simulated）。
WEATHER_SIMULATION=false


# -----------------------------------------------------------------------------
# 6. MySQL（compose 固定 MYSQL_HOST=mysql / PORT=3306 / DATABASE=travel_agent / USERNAME=travel）
# -----------------------------------------------------------------------------
# 必须在首次 `docker compose up` 之前设定；数据卷初始化后再改不会修改既有账号密码。
MYSQL_ROOT_PASSWORD=<强随机口令：root>
MYSQL_PASSWORD=<强随机口令：travel 业务账号>
# 下面 4 项由 compose 以字面量固定，写 .env 不生效，仅列出便于核对：
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_DATABASE=travel_agent
# MYSQL_USERNAME=travel


# -----------------------------------------------------------------------------
# 7. Redis 与照片存储
# -----------------------------------------------------------------------------
# compose 已内置 redis 服务（redis:7-alpine + AOF + healthcheck），并通过
# SPRING_DATA_REDIS_HOST=redis / SPRING_DATA_REDIS_PORT=6379 注入 backend；
# backend 依赖 redis healthy 才启动。RATE_LIMIT_STORE 已在 §2 设为 redis（多实例共享配额）。
# 单实例也可改 memory；Redis 运行期故障时代码 fail-open 放行并告警
# （ratelimit_failopen_total / external.degraded{provider="redis"}）。
# 若用外部 Redis：用 override 改 SPRING_DATA_REDIS_HOST/PORT，密码/TLS 走 SPRING_APPLICATION_JSON。

# local=本地磁盘（默认，/app/data/photos，随 backend-data 卷备份）；
# s3=S3 兼容对象存储（MinIO/OSS/COS，多实例共享）。
# compose 把下面的 S3_* 映射为 TRAVEL_PHOTOS_S3_*；PHOTOS_STORE=s3 时
# S3_BUCKET / S3_ACCESS_KEY / S3_SECRET_KEY 缺失会**启动失败**。
PHOTOS_STORE=local
PHOTO_MAX_PER_TRIP=200
PHOTO_MAX_BYTES_PER_USER=524288000

# S3 连接（PHOTOS_STORE=s3 时填写；local 模式留空）
S3_ENDPOINT=<S3_ENDPOINT 占位：MinIO/OSS/COS 的 endpoint；AWS 可留空>
S3_REGION=us-east-1
S3_BUCKET=<S3_BUCKET 占位>
S3_ACCESS_KEY=<S3_ACCESS_KEY 占位>
S3_SECRET_KEY=<S3_SECRET_KEY 占位>


# -----------------------------------------------------------------------------
# 8. 时区（容器与 JVM 必须一致）
# -----------------------------------------------------------------------------
# Dockerfile 与 compose 都内置 TZ / APP_TIMEZONE=Asia/Shanghai；compose 已透传，可直接改。
# mysql 服务时区由 compose 固定 Asia/Shanghai。
TZ=Asia/Shanghai
APP_TIMEZONE=Asia/Shanghai


# -----------------------------------------------------------------------------
# 9. Agent 预算与会话保留
# -----------------------------------------------------------------------------
# 端到端预算（毫秒）：耗尽不报错，按 ADR-002 降级并标注。compose 已透传。
AGENT_BUDGET_ENABLED=true
AGENT_BUDGET_TOTAL_MS=30000
# 会话记忆：喂给模型的最近消息条数（一轮问答=2 条）；消息保留天数（默认 7）。
CONVERSATION_HISTORY_LIMIT=10
CONVERSATION_RETENTION_DAYS=7
# 知识库历史版本块额外保留数（0=只留 ACTIVE）；compose 已透传。
RAG_CHUNK_VERSION_RETENTION=2


# -----------------------------------------------------------------------------
# 10. 渠道入口（默认关闭；开启后按渠道文档配置）
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
CHANNEL_WEBHOOK_ENABLED=false
CHANNEL_WEBHOOK_SECRET=
# 微信公众号（compose 已透传）
WECHAT_OA_TOKEN=
WECHAT_OA_APPID=
WECHAT_OA_SECRET=

# Telegram 长轮询超时（秒）。compose 未透传，默认 25；要改需 override。
# TELEGRAM_POLL_TIMEOUT=25


# -----------------------------------------------------------------------------
# 11. 日志与 JVM
# -----------------------------------------------------------------------------
# 控制台日志；compose 已为 backend/web 配置 json-file 轮转 10m × 3。
# 需要调堆/GC 时改 JAVA_OPTS（Dockerfile ENTRYPOINT 消费）；compose 已透传。
JAVA_OPTS=-Xmx1g -XX:MaxRAMPercentage=70